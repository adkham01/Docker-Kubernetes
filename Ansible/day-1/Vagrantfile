# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|

  # Define the first Ubuntu 26.04 LTS Node
  config.vm.define "node-1" do |ubuntu|
    ubuntu.vm.box = "cloud-image/ubuntu-26.04"
    ubuntu.vm.hostname = "node-1"
    ubuntu.vm.provider "virtualbox" do |vb|
      vb.memory = "2048"
      vb.cpus = 2
    end
  end

  # Define the second Ubuntu 26.04 LTS Node
  config.vm.define "node-2" do |ubuntu|
    ubuntu.vm.box = "cloud-image/ubuntu-26.04"
    ubuntu.vm.hostname = "node-2"
    ubuntu.vm.provider "virtualbox" do |vb|
      vb.memory = "2048"
      vb.cpus = 2
    end
  end

end